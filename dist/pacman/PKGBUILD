# Maintainer: Lukas Wölfer <lukas.woelfer@rwth-aachen.de>
# Release package — built from the GitHub release tarball.
# CI substitutes pkgver with the actual tag before building.
# https://github.com/corrodedHash/diaria-rs

pkgname=diaria
pkgver=1.3.0
pkgrel=1
pkgdesc="Encrypted, plain-text command-line diary"
arch=('x86_64' 'aarch64')
url="https://github.com/corrodedHash/diaria-rs"
license=('MIT')
makedepends=('cargo')
provides=('diaria')
conflicts=('diaria')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo fetch --locked
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --frozen --locked
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --frozen --locked
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/diaria "$pkgdir/usr/bin/diaria"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
